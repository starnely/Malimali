# ─────────────────────────────────────────────────────────────────────────────
# POS SYSTEM — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Local:      mongodb://localhost:27017/pos-system
# Atlas:      mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/pos-system
MONGO_URI=mongodb://localhost:27017/pos-system

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000

# ── Reverse proxy trust ─────────────────────────────────────────────────────
# Number of reverse-proxy hops in front of this process whose X-Forwarded-For
# entry should be trusted (Express "trust proxy" as a hop count, NOT `true` —
# blanket trust lets a client spoof its own IP past the M-Pesa callback
# allowlist). Default 2 (Cloudflare edge + Render's load balancer) is a
# best-evidence guess, not confirmed by Render's official docs — verify it
# against real traffic using the diagnostic log in
# middleware/mpesaIpAllowlist.js before depending on it, and correct here if
# it doesn't match what you observe.
TRUST_PROXY_HOPS=2

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# ── License ──────────────────────────────────────────────────────────────────
# The activation code clients enter in the Setup Wizard
ACTIVATION_CODE=MALI-2026-PRO

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local dev: http://localhost:5174
# LAN testing: add your machine's Wi-Fi IP (run ipconfig → Wi-Fi IPv4)
# Production: set to your deployed domain only
FRONTEND_URL=http://localhost:5174,http://192.168.1.x:5174

# ── M-Pesa Daraja API (Safaricom) ────────────────────────────────────────────
# Register at https://developer.safaricom.co.ke → create an app → Lipa Na M-Pesa Online
# MPESA_ENV: leave blank or "sandbox" for sandbox; set "production" when going live
# MPESA_CALLBACK_URL: must be a publicly reachable HTTPS URL.
#   For local testing: use ngrok → ngrok http 5000 → copy the https URL + /api/mpesa/callback
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_lipa_na_mpesa_passkey
MPESA_CALLBACK_URL=https://your-ngrok-or-domain.example.com/api/mpesa/callback
MPESA_ENV=sandbox

# ── M-Pesa callback IP allowlist (defense-in-depth, see middleware/mpesaIpAllowlist.js) ──
# MPESA_CALLBACK_IP_ALLOWLIST: comma-separated IPs and/or CIDR ranges (e.g.
#   "196.201.214.200,196.201.212.0/24"). Get the CURRENT list from your Daraja
#   account manager / go-live contact — Safaricom does not publish a stable
#   public list, and old blog-post IPs are reported to go stale. Leave blank
#   until you have a verified list.
# MPESA_IP_ALLOWLIST_MODE: "log" (default, never blocks — just logs what it
#   would have done) or "enforce". Do not set to "enforce" until you've
#   confirmed, from the log output, that req.ip resolves to Safaricom's real
#   IP on an actual callback AND the allowlist above is populated and current.
MPESA_CALLBACK_IP_ALLOWLIST=
MPESA_IP_ALLOWLIST_MODE=log

# ── Africa's Talking SMS Gateway ─────────────────────────────────────────────
# Sign up at https://africastalking.com → create an application → API Key section
#
# AT_USERNAME:
#   Sandbox testing → use the literal string "sandbox" (free, no real SMS sent)
#   Production      → use your actual Africa's Talking account username
#
# AT_API_KEY:
#   Sandbox and production each have a separate API key in the AT dashboard.
#   Copy the key that matches your AT_USERNAME environment.
#
# AT_SENDER_ID:
#   Sandbox → leave blank; AT uses "AFRICASTALKING" as the default sender
#   Production → your registered alphanumeric sender ID (e.g. "MALIPOS")
#   Must be registered with Safaricom for production use (can take several days)
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_sandbox_api_key
AT_SENDER_ID=
